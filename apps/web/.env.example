# URL pública de la API y de Socket.IO para Vite.
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000

# Opcional: habilita la sesión Supabase en el frontend.
# Solo utiliza la publishable/anon key; nunca una service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# El flujo entregable usa la API como coordinador. Usa "supabase-direct" solo para pruebas de acceso directo.
VITE_DATA_SOURCE=api

# Opcional: clave publicable de Stripe para el flujo web.
VITE_STRIPE_PUBLISHABLE_KEY=

# Solo para desarrollo manual de marcador; no usar en producción.
VITE_MATCH_TOKEN=
